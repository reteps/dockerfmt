Instructions whose arguments are words: ENV, ARG, LABEL, MAINTAINER, USER and the like.
-- cases --
# ENV legacy format
FROM alpine
ENV MY_VAR my-value

# ENV legacy value with spaces is quoted
FROM alpine
ENV JAVA_OPTS -Xms256m -Xmx512m

# ENV legacy value with tabs and repeated spaces
FROM alpine
ENV A one	 two   three

# ENV legacy value with variable
FROM alpine
ENV PATH $PATH:/opt/bin /usr/x

# ENV legacy already quoted value
FROM alpine
ENV A "one two"

# ENV legacy value with embedded quotes stays legacy
FROM alpine
ENV A say "hi" there

# ENV modern format
FROM alpine
ENV MY_VAR=my-value

# blank lines inside a continuation are removed
FROM a
ENV A=1 \

  B=2
LABEL a=1 \
  
  # c
  b=2

# ARG basic
FROM alpine
ARG FOO=bar

# LABEL basic
FROM alpine
LABEL version="1.0"

# MAINTAINER converted to LABEL
FROM alpine
MAINTAINER me

# MAINTAINER with embedded quotes
FROM alpine
MAINTAINER Jane Doe "jane@example.com"

# MAINTAINER wrapped in one pair of quotes
FROM alpine
MAINTAINER "Jane Doe"

# MAINTAINER with backslash
FROM alpine
MAINTAINER a\\b

# MAINTAINER with variable is not expanded by LABEL
FROM alpine
MAINTAINER $USER

# MAINTAINER with email in angle brackets
FROM alpine
MAINTAINER Jane Doe <jane@example.com>

# MAINTAINER trailing spaces
FROM alpine
MAINTAINER me   

# MAINTAINER without a value
FROM a
MAINTAINER

# USER
FROM alpine
user nobody

# STOPSIGNAL
FROM alpine
stopsignal SIGTERM

# VOLUME
FROM alpine
volume /data

# WORKDIR
FROM alpine
workdir /app

# HEALTHCHECK NONE uppercased
FROM alpine
healthcheck NONE
