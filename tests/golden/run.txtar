Shell-form RUN, CMD and ENTRYPOINT.
-- cases --
# CMD shell form
FROM alpine
CMD echo hello

# RUN with flags
FROM alpine
RUN --network=host echo hello

# quoted mount target
FROM a
RUN --mount=type=cache,target="/x y"   echo hi

# empty body
FROM a
RUN
0

# separator after the directive line
FROM a
RUN \
\
 echo hi

# shell comment running into the next line
FROM a
RUN echo a&#\
echo b\
#
 echo c

# dangling escape
FROM a
RUN  echo a\\\
echo b

# comment on the directive line is shell code
FROM a
RUN # c \
  echo hi

# backquotes are left alone
FROM a
RUN  echo "`echo \"hi\"`"

# unknown instruction is kept
FROM a
FORM   b \
   c
RUN echo  hi
